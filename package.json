{
  "name": "injaz-alain-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3210",
    "build": "npm run assets && npm run seo:check && npm run lint:rtl && next build && npm run verify",
    "start": "npx serve out -l 3210",
    "seo:check": "node scripts/seo-check.mjs",
    "lint:rtl": "node scripts/rtl-lint.mjs",
    "assets": "node scripts/gen-static-assets.mjs",
    "verify": "node scripts/verify-build.mjs"
  },
  "dependencies": {
    "gray-matter": "4.0.3",
    "next": "^15.5.25",
    "next-mdx-remote": "5.0.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "remark-gfm": "4.0.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.13",
    "@types/node": "24.5.2",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "tailwindcss": "4.1.13",
    "typescript": "5.9.2"
  },
  "allowScripts": {
    "@tailwindcss/oxide@4.1.13": true,
    "sharp@0.34.5": true
  }
}